FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HOME=/home/appuser
ENV WEB_CONCURRENCY=2
ENV PROMETHEUS_MULTIPROC_DIR=/tmp/network_monitoring_prometheus
ENV PROMETHEUS_MULTIPROC_CLEAN_ON_STARTUP=false

RUN addgroup --system appuser \
    && adduser --system --ingroup appuser --home /home/appuser --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY requirements ./requirements
RUN pip install --no-cache-dir -r requirements/backend.txt

COPY alembic.ini .
COPY alembic ./alembic
COPY backend ./backend
COPY shared ./shared
COPY scripts ./scripts

# Synology uploads/extraction can strip source read permissions. Normalize only
# the copied application tree so non-root workers can read it, then precompile
# bytecode for frequent healthcheck interpreter startups.
RUN chmod -R u=rwX,go=rX /app \
    && python -m compileall -q backend shared scripts

RUN chown -R appuser:appuser /app /home/appuser

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "python /app/scripts/prepare_prometheus_multiproc_dir.py && uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers ${WEB_CONCURRENCY:-2}"]
